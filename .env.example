# Copy to .env and fill in your key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# Model and prompt chosen in Step 2
VISION_MODEL=gemini-3.5-flash-lite
PROMPT_VARIANT=improved
PORT=3000
# Location privacy: how far public coordinates may be shifted, in km (Step 3.4)
FUZZ_KM=5
